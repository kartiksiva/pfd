APP_NAME=Process Documentation Agent API
ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Provider defaults
DEFAULT_PROVIDER=google
DEFAULT_PROCESSING_PROFILE=balanced

# API keys (fill these)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_ENABLED=true

# Database (SQLite default; swap with Postgres/SQL Server URL later)
DATABASE_URL=sqlite:///./pfcd.db
UPLOADS_DIR=./uploads
EXPORTS_DIR=./exports
RETENTION_DAYS=7
RETENTION_SWEEP_SECONDS=300
MAX_JOB_DURATION_SECONDS=7200
MAX_PROVIDER_TOKENS=1500000
COST_BAND_MIN_USD=2
COST_BAND_MAX_USD=8
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
PDD_TEMPLATE_PATH=/STANDARD_PDD_TEMPLATE.md

# Task runner adapter: inprocess | celery
TASK_RUNNER=inprocess
REDIS_URL=redis://localhost:6379/0
