APP_NAME=Process Documentation Agent API
ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Provider selection
DEFAULT_PROVIDER=google
DEFAULT_PROCESSING_PROFILE=balanced

# API Keys (fill production values; never commit real secrets)
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODE=auto
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
# Foundry SDK project endpoint (for azure-ai-projects smoke test)
AZURE_FOUNDRY_PROJECT_ENDPOINT=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
LLM_ENABLED=true

# Database
DATABASE_URL=sqlite:///./data/app.db

# File storage paths (must match docker-compose volume mounts)
UPLOADS_DIR=/app/uploads
EXPORTS_DIR=/app/exports

# App settings
ALLOWED_ORIGINS=https://yourdomain.com
RETENTION_DAYS=7
RETENTION_SWEEP_SECONDS=300
MAX_JOB_DURATION_SECONDS=7200
MAX_PROVIDER_TOKENS=1500000
COST_BAND_MIN_USD=2
COST_BAND_MAX_USD=8
OWNER_ACCESS_CODE=PFCD-OWNER-7429
GUEST_ACCESS_CODE=PFCD-GUEST-3184
GUEST_ACCESS_TIMEOUT_MINUTES=30
ACCESS_SESSION_SECRET=change-this-demo-secret
ACCESS_COOKIE_NAME=pfcd_access_session
ACCESS_COOKIE_SECURE=false
PDD_TEMPLATE_PATH=/app/app/templates/STANDARD_PDD_TEMPLATE.md
CUSTOM_SOP_TEMPLATE_PATH=/app/app/templates/Custom_SOP_Template.md

# Task runner adapter: inprocess | celery
TASK_RUNNER=inprocess
REDIS_URL=redis://localhost:6379/0
